<!DOCTYPE html>
<html lang="pt">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Clube de Leitura</title>
  <link rel="stylesheet" href="styles.css" />
</head>
<body>
  <header class="topbar">
    <div>
      <h1>Clube de Leitura</h1>
      <p class="subtitle">Histórico de leitura, sinopses e dúvidas sobre livros</p>
    </div>
  </header>

  <main class="container">
    <section class="card">
      <h2>Adicionar livro</h2>
      <form id="book-form" class="grid-form">
        <label>
          Título
          <input id="title" type="text" required />
        </label>

        <label>
          Autor
          <input id="author" type="text" />
        </label>

        <label>
          Data de início
          <input id="startDate" type="date" />
        </label>

        <label>
          Data de fim
          <input id="endDate" type="date" />
        </label>

        <label>
          Estado
          <select id="status">
            <option value="a_ler">A ler</option>
            <option value="terminado">Terminado</option>
            <option value="pausado">Pausado</option>
          </select>
        </label>

        <label>
          Classificação (0-10)
          <input id="rating" type="number" min="0" max="10" step="0.5" />
        </label>

        <label class="full">
          Notas pessoais
          <textarea id="notes" rows="5" placeholder="Impressões, temas, passagens, ligações, etc."></textarea>
        </label>

        <button type="submit" class="primary">Guardar livro</button>
      </form>
    </section>

    <section class="card">
      <div class="section-head">
        <h2>Biblioteca</h2>
        <input id="search" type="search" placeholder="Procurar por título ou autor" />
      </div>
      <div id="books-list" class="books-list"></div>
    </section>

    <section class="card hidden" id="detail-card">
      <div class="section-head">
        <h2 id="detail-title">Livro</h2>
        <button id="close-detail" class="secondary">Fechar</button>
      </div>

      <div id="detail-meta" class="detail-meta"></div>

      <div class="detail-columns">
        <div>
          <h3>Notas</h3>
          <p id="detail-notes" class="notes-box"></p>

          <h3>Gerar sinopse</h3>
          <textarea id="synopsis-source" rows="6" placeholder="Cola aqui notas, resumo teu ou excerto curto sobre o que leste."></textarea>
          <button id="generate-synopsis" class="primary">Gerar sinopse</button>
          <div id="synopsis-output" class="output-box"></div>
        </div>

        <div>
          <h3>Dúvidas sobre o livro</h3>
          <textarea id="question-input" rows="5" placeholder="Escreve uma pergunta sobre o livro, personagem, tema, passagem ou ideia."></textarea>
          <button id="ask-question" class="primary">Perguntar</button>
          <div id="qa-list" class="qa-list"></div>
        </div>
      </div>
    </section>
  </main>

  <template id="book-item-template">
    <article class="book-item">
      <div>
        <h3 class="book-title"></h3>
        <p class="book-author"></p>
        <p class="book-status"></p>
      </div>
      <div class="book-actions">
        <button class="secondary open-book">Abrir</button>
        <button class="danger delete-book">Apagar</button>
      </div>
    </article>
  </template>

  <script src="app.js"></script>
</body>
</html>